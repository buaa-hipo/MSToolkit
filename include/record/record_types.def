# record type defines
# ACCL 
FOR ACCL
TYPE record_activity_t : record_t
    uint64_t correlation_id : "Correlation ID"
END TYPE

# Overwrite type defines
FOR hipLaunchKernel,hipExtLaunchKernel,hipExtLaunchMultiKernelMultiDevice,hipLaunchCooperativeKernelMultiDevice,hipExtModuleLaunchKernel,hipHccModuleLaunchKernel,hipLaunchCooperativeKernel,hipLaunchKernel_internal,hipModuleLaunchKernel
TYPE record_activity_launch_t : record_t
    uint64_t correlation_id : "Correlation ID"
    STRUCT blockNum : "{x},{y},{z}"
        uint32_t x : "first dimension of grid"
        uint32_t y : "second dimension of grid"
        uint32_t z : "third dimension of grid"
    END STRUCT
    STRUCT blockDim : "{x},{y},{z}"
        uint32_t x : "first dimension of block"
        uint32_t y : "second dimension of block"
        uint32_t z : "third dimension of block"
    END STRUCT
    uint32_t sharedMemBytes : "shared memory used in bytes"
    const void* stream : "stream running the workload"
END TYPE

FOR hipMemcpyAsync,hipDrvMemcpy3DAsync,hipMemcpy2DAsync,hipMemcpy2DFromArrayAsync,hipMemcpy2DToArrayAsync,hipMemcpy3DAsync,hipMemcpyDtoDAsync,hipMemcpyDtoHAsync,hipMemcpyFromSymbolAsync,hipMemcpyHtoDAsync,hipMemcpyParam2DAsync,hipMemcpyPeerAsync,hipMemcpyToSymbolAsync,hipMemcpyWithStream
TYPE record_activity_memcpy_async_t : record_t
    uint64_t correlation_id : "Correlation ID" 
    const void* dst : "memory copy destination address"
    const void* src : "memory copy source address"
    size_t sizeBytes : "memory copy byte count"
    uint32_t kind : "direction of memory copy"
    const void* stream : "stream running the workload"
END TYPE

FOR hipMemcpy,hipDrvMemcpy2DUnaligned,hipDrvMemcpy3D,hipMemcpy2D,hipMemcpy2DFromArray,hipMemcpy2DToArray,hipMemcpy3D,hipMemcpyAtoH,hipMemcpyDtoD,hipMemcpyDtoH,hipMemcpyFromArray,hipMemcpyFromSymbol,hipMemcpyHtoA,hipMemcpyHtoD,hipMemcpyParam2D,hipMemcpyPeer,hipMemcpyToArray,hipMemcpyToSymbol
TYPE record_activity_memcpy_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* dst : "memory copy destination address"
    const void* src : "memory copy source address"
    size_t sizeBytes : "memory copy byte count"
    uint32_t kind : "direction of memory copy"
END TYPE

FOR hipArray3DCreate,hipArrayCreate,hipExtHostMalloc,hipExtMallocWithFlags,hipHostAlloc,hipHostMalloc,hipMalloc,hipMalloc3D,hipMalloc3DArray,hipMallocArray,hipMallocAsync,hipMallocFromPoolAsync,hipMallocHost,hipMallocManaged,hipMallocMipmappedArray,hipMallocPitch,hipMemAllocHost,hipMemAllocPitch
TYPE record_activity_mem_alloc_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* ptr : "allocated memory address"
    size_t sizeBytes : "allocated byte count"
    uint32_t kind : "location area of memory"
    int32_t cpu_id : "CPU core ID bounded"
    const void *stream : "stream running the workload"
END TYPE

FOR hipArrayDestroy,hipMipmappedArrayDestroy,hipFree,hipFreeArray,hipFreeAsync,hipFreeHost,hipFreeMipmappedArray,hipHostFree,hipMemAddressFree
TYPE record_activity_free_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* ptr : "allocated memory address"
    size_t sizeBytes : "allocated byte count"
    uint32_t kind : "location area of memory"
    const void* stream : "stream running the workload"
END TYPE

FOR hipEventSynchronize,hipStreamSynchronize,hipStreamWaitEvent
TYPE record_activity_wait_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* event : "HIP event pointer"
    const void* stream : "stream running the workload"
END TYPE

FOR hipEventCreate,hipEventCreateWithFlags,hipEventDestroy,hipEventRecord
TYPE record_activity_event_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* event : "HIP event pointer"
    const void* stream : "stream running the workload"
END TYPE

# MATRIX
FOR ACCL_API_group_create,ACCL_API_group_create_masked_launch,ACCL_API_group_create_launch,ACCL_API_group_exec,ACCL_API_group_destroy
TYPE mt_record_kernel_launch_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID of the thread group"
    uint32_t thread_num : "Number of threads in the group"
    uint32_t group_id : "ID of the dsp thread group"
    uint32_t thread_mask : "Bit mask of thread activated in the cluster"
    uint32_t scalar_args_num : "Number of scalar arguments for the kernel"
    uint32_t ptr_args_num : "Number of pointer arguments for the kernel"
END TYPE

FOR ACCL_API_dat_load,ACCL_API_dat_unload,ACCL_API_dev_open,ACCL_API_dev_close
TYPE mt_record_driver_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID of the thread group"
    uint32_t kind : "0 for on, 1 for off"
END TYPE

FOR ACCL_API_barrier_create,ACCL_API_barrier_destroy
TYPE mt_record_barrier_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID of the thread group"
    int32_t barrier_id : "ID of barrier unit"
    uint32_t kind : "0 for on, 1 for off"
END TYPE

FOR ACCL_API_rwlock_create,ACCL_API_rwlock_destroy
TYPE mt_record_rwlock_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID of the thread group"
    int32_t lock_id : "ID of rw lock unit"
    uint32_t kind : "0 for on, 1 for off"
END TYPE

FOR ACCL_API_intr_send,ACCL_API_intr_reg
TYPE mt_record_intr_t : record_t
    uint64_t correlation_id : "Correlation ID"
    uint32_t group_id : "Thread group ID"
    uint32_t thread_id : "Thread ID inside group"
    uint64_t intr_id : "Interrupt signal"
    const void* func : "Interrupt handler function"
END TYPE

FOR ACCL_API_group_wait
TYPE mt_record_group_wait_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t group_id : "Thread group ID"
END TYPE

FOR ACCL_API_vector_load,ACCL_API_vector_store,ACCL_API_scalar_load,ACCL_API_scalar_store
TYPE mt_record_memcpy_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void *src : "Source address of memcpy"
    const void *dst : "Destination address of memcpy"
    uint64_t bytes : "Bytes of data to be copied"
    uint32_t kind : "Direction of memcpy"
END TYPE

FOR ACCL_API_scalar_load_async, ACCL_API_scalar_store_async,ACCL_API_vector_load_async,ACCL_API_vector_store_async,ACCL_API_dma_p2p,ACCL_API_dma_broadcast,ACCL_API_dma_segment,ACCL_API_dma_sg
TYPE mt_record_memcpy_async_t : record_t
    uint64_t correlation_id : "Correlation ID"
    const void* src : "Source address of memcpy"
    const void* dst : "Destination address of memcpy"
    uint64_t bytes : "Bytes of data to be copied"
    uint32_t kind : "Direction of memcpy"
    uint16_t dma_channel : "DMA channel used for asynchronous memcpy"
END TYPE

FOR ACCL_API_malloc,ACCL_API_vector_malloc,ACCL_API_scalar_malloc,ACCL_API_hbm_malloc
TYPE mt_record_malloc_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID of the allocated memory"
    uint32_t bytes : "Bytes of memory allocated"
    uint32_t mode : "Mode of memory allocated (read only / write only / read write / cache)"
    uint32_t kind : "Memory kind (hardware location)"
END TYPE

FOR ACCL_API_free,ACCL_API_vector_free,ACCL_API_scalar_free,ACCL_API_hbm_free
TYPE mt_record_free_t : record_t
    uint64_t correlation_id : "Correlation ID"
    void* address : "Address to be freed"
END TYPE

FOR ACCL_API_dma_wait,ACCL_API_dma_wait_p2p,ACCL_API_dma_wait_sg
TYPE mt_record_dma_wait_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t cluster_id : "Cluster ID"
    uint32_t dma_channel : "DMA channel used for asynchronous memcpy"
END TYPE

FOR ACCL_API_group_barrier,ACCL_API_core_barrier,ACCL_API_core_barrier_wait
TYPE mt_record_dev_barrier_t : record_t
    uint64_t correlation_id : "Correlation ID"
    int32_t barrier_id : "ID of barrier unit"
    uint32_t core_num : "Number of cores needed to pass the barrier"
    uint64_t timeout : "Timeout in clock cycles"
END TYPE

FOR ACCL_API_rwlock_try_rdlock,ACCL_API_rwlock_try_wrlock,ACCL_API_rwlock_rdlock,ACCL_API_rwlock_wrlock,ACCL_API_rwlock_unlock
TYPE mt_record_dev_rwlock_t : record_t
    uint64_t correlation_id : "Correlation ID"
    uint32_t lock_id : "ID of rw lock"
    uint32_t op_kind : "0/1 for try on read/write lock, 2/3 for blocking try on read/write lock, 4 for unlock"
END TYPE

FOR ACCL_API_intr_handler_register,ACCL_API_cpu_interrupt
TYPE mt_record_dev_intr_t : record_t
    uint64_t correlation_id : "Correlation ID"
    uint64_t intr_id : "Interrupt signal"
    const void* func : "Interrupt handler function"
END TYPE

FOR ACCL_ACTIVITY_kernel
TYPE mt_record_kernel_t : record_t
    uint64_t correlation_id : "Correlation ID"
    uint16_t domain : "API or Operation domain"
    uint16_t op : "API kind or Kernel index (offset)"
    uint32_t kind : "Workload kind"
END TYPE

# MPI
FOR MPI_Send,MPI_Recv
TYPE record_comm_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int dest : "Dest/Src"
	int tag : "Tag"
    int count : "Count"
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Comm_rank
TYPE record_comm_rank_t : record_t
    uint64_t comm : "MPI Comm"
    int rank : "MPI Rank"
END TYPE

FOR MPI_Comm_dup
TYPE record_comm_dup_t : record_t
    uint64_t comm : "MPI Comm"
    uint64_t new_comm : "New MPI Comm"
END TYPE

FOR MPI_Comm_split
TYPE record_comm_split_t : record_t
    uint64_t comm : "MPI Comm"
    uint64_t new_comm : "New MPI Comm"
    int color : "Color"
END TYPE

FOR MPI_Alltoall, MPI_Alltoallv
TYPE record_all2all_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int sendcnt : "Send count"
	int recvcnt : "Recv count"
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Allreduce
TYPE record_allreduce_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int count : "Count"
	uint64_t op : "MPI Op"
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Reduce
TYPE record_reduce_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int count : "Count"
    int root : "Root"
	uint64_t op : "MPI Op"
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Bcast
TYPE record_bcast_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int count : "Count"
    int root : "Root"
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Barrier
TYPE record_barrier_t : record_t
    uint64_t comm : "MPI Comm"
END TYPE

FOR MPI_Isend, MPI_Irecv
TYPE record_comm_async_t : record_t
    uint64_t datatype : "Data type"
    int typesize : "Type Size"
	int dest : "Dest/Src"
	int tag : "Tag"
    int count : "Count"
    uint64_t comm : "MPI Comm"
    uint64_t request : "MPI Request"
END TYPE

FOR MPI_Wait
TYPE record_comm_wait_t : record_t
    uint64_t request : "MPI Request"
END TYPE

